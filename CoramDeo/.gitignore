# Base de données de l'outillage local Ruflo / RuVector (hors site web)
ruvector.db

# Copies de sauvegarde Windows (« - Copie »)
* - Copie*

# Outillage local Claude Code (config propre à la machine, verrous transitoires),
# sauf les skills versionnés et la bibliothèque partagée dont leurs scripts dépendent.
**/.claude/*
!**/.claude/skills/
!**/.claude/shared/

# Cache de bytecode Python (artefacts de build)
__pycache__/
*.pyc

# Artefacts transitoires des skills sermon-* (JSON intermédiaires)
_temp.json
serie-de-predications-temp.json
recherche-temp.json
serie-temp.json

# Sources protégées (licence d'usage personnel, non redistribuables) : elles vivent hors dépôt,
# dans CORAMDEO_SOURCES (défaut %USERPROFILE%\CoramDeo-sources), lues par extract_nt.py / extract_at.py.
NEG - *.md
JMA - *.md
NEG - MacArthur.pdf
Vallée de la Vision.pdf
3 - Pérégrination/00 - Avant-propos/Puritains/*.docx
3 - Pérégrination/00 - Avant-propos/Puritains/*.pptx
3 - Pérégrination/00 - Avant-propos/Vallée de la Vision/*.pptx
